<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#1A1A1A">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/config_title"
        android:fontFamily="@font/bangers"
        android:textColor="#FFC300"
        android:textSize="24sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vault_hunter_name_label"
        android:fontFamily="@font/luckiest_guy"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/editUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/echo_card_bg"
        android:padding="12dp"
        android:textColor="@color/black"
        android:inputType="textPersonName"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_avatar_label"
        android:fontFamily="@font/luckiest_guy"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/avatar0"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:padding="4dp"
                android:background="@drawable/echo_card_bg"
                android:src="@drawable/ic_claptrap_standard"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:id="@+id/avatar1"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:padding="4dp"
                android:background="@drawable/echo_card_bg"
                android:src="@drawable/ic_claptrap_hyperion"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:id="@+id/avatar2"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:padding="4dp"
                android:background="@drawable/echo_card_bg"
                android:src="@drawable/ic_claptrap_maliwan"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:id="@+id/avatar3"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:padding="4dp"
                android:background="@drawable/echo_card_bg"
                android:src="@drawable/ic_claptrap_stealth"/>
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_theme_label"
        android:fontFamily="@font/luckiest_guy"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPandora"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:text="PANDORA"
                android:textSize="10sp"
                android:fontFamily="@font/luckiest_guy"
                android:backgroundTint="#FFC300"
                android:textColor="@color/black"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnHyperion"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:text="HYPERION"
                android:textSize="10sp"
                android:fontFamily="@font/luckiest_guy"
                android:backgroundTint="#F1FAEE"
                android:textColor="@color/black"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnMaliwan"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:text="MALIWAN"
                android:textSize="10sp"
                android:fontFamily="@font/luckiest_guy"
                android:backgroundTint="#06D6A0"
                android:textColor="@color/black"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnJakobs"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:text="JAKOBS"
                android:textSize="10sp"
                android:fontFamily="@font/luckiest_guy"
                android:backgroundTint="#D4A373"
                android:textColor="@color/black"/>
        </LinearLayout>
    </HorizontalScrollView>

    <Button
        android:id="@+id/btnSaveProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/save_changes"
        android:fontFamily="@font/luckiest_guy"
        android:backgroundTint="#E63946"
        android:textColor="#FFFFFF"
        android:padding="12dp"/>

</LinearLayout>
