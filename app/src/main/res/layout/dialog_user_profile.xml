<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#1A1A1A">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/config_title"
        android:fontFamily="@font/bangers"
        android:textColor="#FFC300"
        android:textSize="24sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vault_hunter_name_label"
        android:fontFamily="@font/luckiest_guy"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/editUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/echo_card_bg"
        android:padding="12dp"
        android:textColor="@color/black"
        android:inputType="textPersonName"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_avatar_label"
        android:fontFamily="@font/luckiest_guy"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/avatar0"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:padding="4dp"
                android:background="@drawable/echo_card_bg"
                android:src="@drawable/ic_claptrap_standard"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:id="@+id/avatar1"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:padding="4dp"
                android:background="@drawable/echo_card_bg"
                android:src="@drawable/ic_claptrap_hyperion"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:id="@+id/avatar2"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:padding="4dp"
                android:background="@drawable/echo_card_bg"
                android:src="@drawable/ic_claptrap_maliwan"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:id="@+id/avatar3"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:padding="4dp"
                android:background="@drawable/echo_card_bg"
                android:src="@drawable/ic_claptrap_stealth"/>
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_theme_label"
        android:fontFamily="@font/luckiest_guy"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPandora"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:text="@string/theme_pandora"
                android:textSize="10sp"
                android:fontFamily="@font/luckiest_guy"
                android:backgroundTint="#FF6B00"
                android:textColor="#1C1B17"
                app:strokeColor="#1C1B17"
                app:strokeWidth="3dp"
                app:cornerRadius="0dp"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHyperion"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:text="@string/theme_hyperion"
                android:textSize="10sp"
                android:fontFamily="@font/luckiest_guy"
                android:backgroundTint="#FFCC00"
                android:textColor="#1A1A1A"
                app:strokeColor="#1A1A1A"
                app:strokeWidth="3dp"
                app:cornerRadius="0dp"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMaliwan"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:text="@string/theme_maliwan"
                android:textSize="10sp"
                android:fontFamily="@font/luckiest_guy"
                android:backgroundTint="#00F5D4"
                android:textColor="#0A1F1A"
                app:strokeColor="#0A1F1A"
                app:strokeWidth="3dp"
                app:cornerRadius="0dp"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnJakobs"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:text="@string/theme_jakobs"
                android:textSize="10sp"
                android:fontFamily="@font/luckiest_guy"
                android:backgroundTint="#D4A373"
                android:textColor="#2A1F14"
                app:strokeColor="#2A1F14"
                app:strokeWidth="3dp"
                app:cornerRadius="0dp"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuac"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:text="@string/theme_guac"
                android:textSize="10sp"
                android:fontFamily="@font/luckiest_guy"
                android:backgroundTint="#C6FF00"
                android:textColor="#1F2A0F"
                app:strokeColor="#1F2A0F"
                app:strokeWidth="3dp"
                app:cornerRadius="0dp"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTorgue"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:text="TORGUE"
                android:textSize="10sp"
                android:fontFamily="@font/luckiest_guy"
                android:backgroundTint="#FFD60A"
                android:textColor="#000000"
                app:strokeColor="#D90429"
                app:strokeWidth="3dp"
                app:cornerRadius="0dp"/>

        </LinearLayout>
    </HorizontalScrollView>

    <Button
        android:id="@+id/btnSaveProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/save_changes"
        android:fontFamily="@font/luckiest_guy"
        android:backgroundTint="#E63946"
        android:textColor="#FFFFFF"
        android:padding="12dp"/>

</LinearLayout>